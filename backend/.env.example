# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=log
TRUST_PROXY=false
# Comma-separated exact origins. Leave empty when all browser traffic uses the
# frontend's same-origin /api proxy.
CORS_ORIGINS=http://localhost:3001

# PostgreSQL. Managed production databases normally require sslmode=require.
DATABASE_URL=postgresql://perplexity:change-me@localhost:5432/perplexity?schema=public

# Search (required)
TAVILY_API_KEY=tvly-dev-placeholder
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_SEARCH_TIMEOUT_MS=6000

# AI (required; the active model runs on Groq behind these generic keys)
AI_PROVIDER_API_KEY=placeholder
AI_DEFAULT_MODEL=openai/gpt-oss-120b
AI_FAST_MODEL=openai/gpt-oss-20b
AI_ANSWER_TIMEOUT_MS=16000
AI_QUERY_REWRITE_TIMEOUT_MS=6000
AI_SUGGESTION_TIMEOUT_MS=15000
